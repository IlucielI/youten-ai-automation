# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
ENV=local
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://reqres.in/api

# Browser Settings
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
# BROWSER_WS_ENDPOINT=ws://localhost:3000
# PROXY_URL=
# PROXY_LIST=

# Test Execution & Artifacts
RETRIES=0
WORKERS=2
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false
TRACE_ON_FAILURE=true

# Credentials (if needed)
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=SecretPassword123!

# ==============================================================================
# 1. AUTOMATION RUNNER INTERNAL SERVICES
# ==============================================================================
# Internal Redis instance for worker tokens, storageState & test execution locks
AUTOMATION_REDIS_HOST=localhost
AUTOMATION_REDIS_PORT=6379
AUTOMATION_REDIS_PASSWORD=
AUTOMATION_REDIS_DB=0

# ==============================================================================
# 2. TARGET APPLICATION (SUT) SERVICES (Always prefixed with TARGET_)
# ==============================================================================

# Target Database (PostgreSQL / MySQL)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=postgres
TARGET_DB_NAME=test_db

# Target Redis (User OTPs, Rate Limits, App Sessions)
TARGET_REDIS_HOST=localhost
TARGET_REDIS_PORT=6380
TARGET_REDIS_PASSWORD=
TARGET_REDIS_DB=0

# Target S3 Storage (AWS S3, MinIO, LocalStack for policy files, receipts, claims)
TARGET_S3_ENDPOINT=http://localhost:9000
TARGET_S3_REGION=us-east-1
TARGET_S3_BUCKET=target-app-uploads
TARGET_S3_ACCESS_KEY_ID=minioadmin
TARGET_S3_SECRET_ACCESS_KEY=minioadmin
TARGET_S3_FORCE_PATH_STYLE=true

# ==============================================================================
# 3. QA EMAIL / INBOX PROVIDER (Outlook, Gmail, Custom SMTP/IMAP, Maildev)
# ==============================================================================
# Active provider: maildev | outlook | gmail | custom
EMAIL_PROVIDER=maildev
MAILDEV_URL=http://127.0.0.1:1080
SKIP_EMAIL=false

# Microsoft Outlook / Hotmail (Microsoft Graph API)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# Google Gmail (Gmail API)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Custom SMTP / IMAP Provider
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ==============================================================================
# 4. SECURITY & AI EVALUATION ADAPTERS
# ==============================================================================

# LLM / AI Evaluation Adapter (OpenAI-compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
# 2FA TOTP Generator Secret
TOTP_SECRET=JBSWY3DPEHPK3PXP

# ==============================================================================
# 5. DESIGN QA & VISUAL FIDELITY PROVIDER (Figma & Penpot)
# ==============================================================================
# Active provider: mock | figma | penpot (Default: mock for zero-config resilience)
DESIGN_PROVIDER=mock

# Figma REST API
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# Penpot REST API (Cloud or Self-hosted Docker instance)
PENPOT_BASE_URL=https://design.penpot.app
PENPOT_TOKEN=
PENPOT_FILE_ID=
